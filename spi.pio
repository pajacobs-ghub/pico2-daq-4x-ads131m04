; spi.pio
; Cut-down copy of the full-duplex SPI example from section 11.6.1 of the RP2350 Data Sheet
;
; - Only CPOL=0 CPHA=1 is implemented, as this suits the ADS131M04 converter chip.
;   Data transitions on SCK going high (leading edge of clock pulse).
;   Data read on SCK going low (trailing edge of pulse).
; - Pin assignments:
;   - SCK is side-set pin 0
;   - MOSI is OUT pin 0
;   - MISO is IN pin 0
; - Autopush and autopull are used and the frame-size is set via the threshold.
; - Frame size is 8 bits, for single byte exchanges.
; - Shifting is to the left to send/receive the MSb first.
; - We assume that the FIFO register interactions happen via 8-bit writes and reads.
;   This takes advantage of the narrow store byte replication and narrow read byte selection
;   behaviour of the RP2350 bus fabric.  See section 2.1.5 of the data sheet.
;
; Peter J. 2026-11-01

.program spi_cpol0_cpha1
.pio_version RP2350
; sysclk at 150MHz (6.6667ns period)
; Want the PIO instruction cycle to be 31.25ns so that 4xPIO cycles is 125ns
; for an 8 MHz SPI clock frequency.
.clock_div 4.6875
.fifo txrx
.side_set 1
.in 1 left auto 8
.out 1 left auto 8

.wrap_target
    out x, 1    side 0     ; Stall here on empty, keeping SCK low.
    mov pins, x side 1 [1] ; Output data, SCK goes high (mov pins uses OUT mapping)
    in pins, 1  side 0     ; Input data, SCK goes low
.wrap

% c-sdk {
#include "hardware/gpio.h"
static inline void pio_spi_init(PIO pio, uint sm, uint prog_offs,
                                uint pin_sck, uint pin_mosi, uint pin_miso) {
    pio_sm_config c = spi_cpol0_cpha1_program_get_default_config(prog_offs);
    sm_config_set_out_pins(&c, pin_mosi, 1);
    sm_config_set_in_pins(&c, pin_miso);
    sm_config_set_sideset_pins(&c, pin_sck);

    pio_gpio_init(pio, pin_mosi);
    gpio_set_slew_rate(pin_mosi, GPIO_SLEW_RATE_FAST);
    pio_gpio_init(pio, pin_miso);
    gpio_pull_down(pin_miso);
    pio_gpio_init(pio, pin_sck);
    gpio_set_slew_rate(pin_sck, GPIO_SLEW_RATE_FAST);

    // MOSI, SCK output are low, MISO is input
    pio_sm_set_pins_with_mask64(pio, sm, 0, (1ull << pin_sck) | (1ull << pin_mosi));
    pio_sm_set_pindirs_with_mask64(pio, sm, (1ull << pin_sck) | (1ull << pin_mosi),
                                   (1ull << pin_sck) | (1ull << pin_mosi) | (1ull << pin_miso));

    // SPI is synchronous, so bypass input synchroniser to reduce input delay.
    pio_set_input_sync_bypass_with_mask64(pio, 1ull << pin_miso, 1ull << pin_miso);

    pio_sm_init(pio, sm, prog_offs, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
